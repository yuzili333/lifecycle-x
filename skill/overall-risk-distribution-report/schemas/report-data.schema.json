{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cycle-probe.local/schemas/overall-risk-distribution-report-data.schema.json",
  "title": "OverallRiskDistributionAnalysisResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataSourceName", "sourceFields", "countBasis", "countBasisField", "fallbackCode", "analyzedRecordCount", "excludedRecordCount", "totals", "fiveLevelDistribution", "nonperformingSummary", "riskResultDistribution", "validation"],
  "properties": {
    "dataSourceName": { "type": "string", "minLength": 1 },
    "sourceFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fiveLevelClassification", "riskClassificationResult", "loanBalance", "loanBalanceUnit", "contractAmount", "contractAmountUnit", "contractSerial"],
      "properties": {
        "fiveLevelClassification": { "type": "string", "minLength": 1 },
        "riskClassificationResult": { "type": ["string", "null"] },
        "loanBalance": { "type": "string", "minLength": 1 },
        "loanBalanceUnit": { "type": ["string", "null"] },
        "contractAmount": { "type": ["string", "null"] },
        "contractAmountUnit": { "type": ["string", "null"] },
        "contractSerial": { "type": ["string", "null"] }
      }
    },
    "countBasis": { "type": "string", "enum": ["contract_serial", "valid_rows"] },
    "countBasisField": { "type": ["string", "null"] },
    "fallbackCode": { "type": ["string", "null"], "enum": ["missing_contract_serial", "blank_contract_serial", "conflicting_contract_records", null] },
    "analyzedRecordCount": { "type": "integer", "minimum": 0 },
    "excludedRecordCount": { "type": "integer", "minimum": 0 },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "loanBalance", "contractAmount"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "loanBalance": { "type": "number", "minimum": 0 },
        "contractAmount": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "fiveLevelDistribution": { "type": "array", "items": { "$ref": "#/$defs/distributionItem" } },
    "nonperformingSummary": { "$ref": "#/$defs/distributionItem" },
    "riskResultDistribution": { "type": "array", "items": { "$ref": "#/$defs/distributionItem" } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countReconciled", "loanBalanceReconciled", "contractAmountReconciled"],
      "properties": {
        "countReconciled": { "const": true },
        "loanBalanceReconciled": { "const": true },
        "contractAmountReconciled": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "distributionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "count", "countShare", "loanBalance", "loanBalanceShare", "contractAmount"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 },
        "countShare": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "loanBalance": { "type": "number", "minimum": 0 },
        "loanBalanceShare": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "contractAmount": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}
