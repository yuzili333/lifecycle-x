{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cycle-probe.local/schemas/branch-asset-quality-report-data.schema.json",
  "title": "BranchAssetQualityAnalysisResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataSourceName", "sourceFields", "countBasis", "countBasisField", "fallbackCode", "analyzedRecordCount", "excludedRecordCount", "branchCount", "branchDistribution", "overall", "validation"],
  "properties": {
    "dataSourceName": { "type": "string", "minLength": 1 },
    "sourceFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "fiveLevelClassification", "amount", "amountSourceUnit", "contractSerial"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "fiveLevelClassification": { "type": "string", "minLength": 1 },
        "amount": { "type": "string", "minLength": 1 },
        "amountSourceUnit": { "type": ["string", "null"] },
        "contractSerial": { "type": ["string", "null"] }
      }
    },
    "countBasis": { "type": "string", "enum": ["contract_serial", "valid_rows"] },
    "countBasisField": { "type": ["string", "null"] },
    "fallbackCode": { "type": ["string", "null"], "enum": ["missing_contract_serial", "blank_contract_serial", "conflicting_contract_records", null] },
    "analyzedRecordCount": { "type": "integer", "minimum": 0 },
    "excludedRecordCount": { "type": "integer", "minimum": 0 },
    "branchCount": { "type": "integer", "minimum": 0 },
    "branchDistribution": { "type": "array", "items": { "$ref": "#/$defs/branchRow" } },
    "overall": { "$ref": "#/$defs/branchRow" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branchSetReconciled", "countReconciled", "amountReconciled"],
      "properties": {
        "branchSetReconciled": { "const": true },
        "countReconciled": { "const": true },
        "amountReconciled": { "const": true }
      }
    }
  },
  "$defs": {
    "branchRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branchName", "counts", "amounts"],
      "properties": {
        "branchName": { "type": "string", "minLength": 1 },
        "counts": { "$ref": "#/$defs/countGroup" },
        "amounts": { "$ref": "#/$defs/amountGroup" }
      }
    },
    "countGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normal", "attention", "nonperforming", "total", "nonperformingRate", "attentionRate"],
      "properties": {
        "normal": { "type": "integer", "minimum": 0 },
        "attention": { "type": "integer", "minimum": 0 },
        "nonperforming": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "nonperformingRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "attentionRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "amountGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normal", "attention", "nonperforming", "total", "nonperformingRate", "attentionRate"],
      "properties": {
        "normal": { "type": "number", "minimum": 0 },
        "attention": { "type": "number", "minimum": 0 },
        "nonperforming": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 },
        "nonperformingRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "attentionRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    }
  }
}
