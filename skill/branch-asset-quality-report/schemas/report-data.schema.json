{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cycle-probe.local/schemas/branch-asset-quality-report-data.schema.json",
  "title": "BranchAssetQualityReportData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataSourceName",
    "countBasis",
    "countBasisField",
    "fallbackReason",
    "deduplicatedRecordCount",
    "excludedRecordCount",
    "sourceFields",
    "overall",
    "branchDistribution",
    "validation",
    "conclusions",
    "dataQualityNote"
  ],
  "properties": {
    "dataSourceName": {
      "type": "string",
      "minLength": 1
    },
    "countBasis": {
      "type": "string",
      "enum": [
        "contract_serial",
        "valid_rows"
      ]
    },
    "countBasisField": {
      "type": [
        "string",
        "null"
      ]
    },
    "fallbackReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "deduplicatedRecordCount": {
      "type": "integer",
      "minimum": 0
    },
    "excludedRecordCount": {
      "type": "integer",
      "minimum": 0
    },
    "sourceFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "fiveLevelClassification",
        "loanBalance",
        "loanBalanceSourceUnit",
        "amountBusinessName",
        "amountDisplayUnit"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "fiveLevelClassification": {
          "type": "string",
          "minLength": 1
        },
        "loanBalance": {
          "type": "string",
          "minLength": 1
        },
        "loanBalanceSourceUnit": {
          "type": [
            "string",
            "null"
          ]
        },
        "amountBusinessName": {
          "type": "string",
          "minLength": 1,
          "description": "报告采用的金额指标业务名称；用户未指定时为贷款余额。"
        },
        "amountDisplayUnit": {
          "type": "string",
          "minLength": 1,
          "description": "四个金额列表头使用的单位标签，不包含括号或斜杠；默认万。"
        },
        "contractSerial": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "overall": {
      "$ref": "#/$defs/assetQualityRow"
    },
    "branchDistribution": {
      "type": "array",
      "minItems": 1,
      "description": "采用最终笔数口径后的全部真实分行，每个分行恰好一行；禁止 Top N 截断或加入虚构分行。",
      "items": {
        "$ref": "#/$defs/assetQualityRow"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinctBranchCount",
        "distributionRowCount",
        "branchTotalCount",
        "overallTotalCount",
        "branchSetReconciled",
        "countReconciled",
        "balanceReconciled"
      ],
      "properties": {
        "distinctBranchCount": {
          "type": "integer",
          "minimum": 1
        },
        "distributionRowCount": {
          "type": "integer",
          "minimum": 1
        },
        "branchTotalCount": {
          "type": "integer",
          "minimum": 0
        },
        "overallTotalCount": {
          "type": "integer",
          "minimum": 0
        },
        "branchSetReconciled": {
          "const": true,
          "description": "真实分行集合与 branchDistribution 分行集合完全一致。"
        },
        "countReconciled": {
          "const": true,
          "description": "分行笔数合计、全行笔数和最终有效记录数完全一致。"
        },
        "balanceReconciled": {
          "const": true,
          "description": "各分行分类金额、分行金额合计和全行金额在 Decimal 精度下完全一致。"
        }
      }
    },
    "conclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nonperforming",
        "attentionConcentration",
        "attentionWatch",
        "stableLeading"
      ],
      "properties": {
        "nonperforming": {
          "type": "string",
          "minLength": 1,
          "description": "存在不良分行的结论；无不良时明确说明。"
        },
        "attentionConcentration": {
          "type": [
            "string",
            "null"
          ]
        },
        "attentionWatch": {
          "type": [
            "string",
            "null"
          ]
        },
        "stableLeading": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "dataQualityNote": {
      "type": [
        "string",
        "null"
      ],
      "description": "仅在存在排除记录或口径降级时提供的一句说明。"
    }
  },
  "$defs": {
    "assetQualityRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branchName",
        "normalCount",
        "attentionCount",
        "nonperformingCount",
        "totalCount",
        "nonperformingCountRate",
        "nonperformingCountRateDisplay",
        "attentionCountRate",
        "attentionCountRateDisplay",
        "normalBalance",
        "normalBalanceDisplay",
        "attentionBalance",
        "attentionBalanceDisplay",
        "nonperformingBalance",
        "nonperformingBalanceDisplay",
        "totalBalance",
        "totalBalanceDisplay",
        "nonperformingBalanceRate",
        "nonperformingBalanceRateDisplay",
        "attentionBalanceRate",
        "attentionBalanceRateDisplay"
      ],
      "properties": {
        "branchName": {
          "type": "string",
          "minLength": 1
        },
        "normalCount": {
          "type": "integer",
          "minimum": 0
        },
        "attentionCount": {
          "type": "integer",
          "minimum": 0
        },
        "nonperformingCount": {
          "type": "integer",
          "minimum": 0
        },
        "totalCount": {
          "type": "integer",
          "minimum": 0,
          "description": "仅由当前 branchName 对应的真实记录计算；禁止复制 overall.totalCount。"
        },
        "nonperformingCountRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nonperformingCountRateDisplay": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$",
          "description": "不附加百分号的两位小数。"
        },
        "attentionCountRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "attentionCountRateDisplay": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}$"
        },
        "normalBalance": {
          "type": "number"
        },
        "normalBalanceDisplay": {
          "type": "string",
          "minLength": 1,
          "description": "保留源单位精度并使用千分位的表格展示值。"
        },
        "attentionBalance": {
          "type": "number"
        },
        "attentionBalanceDisplay": {
          "type": "string",
          "minLength": 1
        },
        "nonperformingBalance": {
          "type": "number"
        },
        "nonperformingBalanceDisplay": {
          "type": "string",
          "minLength": 1
        },
        "totalBalance": {
          "type": "number"
        },
        "totalBalanceDisplay": {
          "type": "string",
          "minLength": 1
        },
        "nonperformingBalanceRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "nonperformingBalanceRateDisplay": {
          "type": "string",
          "pattern": "^(--|\\d+\\.\\d{2})$"
        },
        "attentionBalanceRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "attentionBalanceRateDisplay": {
          "type": "string",
          "pattern": "^(--|\\d+\\.\\d{2})$"
        }
      }
    }
  }
}
