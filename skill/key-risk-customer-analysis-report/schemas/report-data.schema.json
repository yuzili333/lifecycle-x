{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cycle-probe.local/schemas/key-risk-customer-analysis-report-data.schema.json",
  "title": "KeyRiskCustomerAnalysisResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataSourceName", "sourceFields", "countBasis", "countBasisField", "fallbackCode", "analyzedRecordCount", "excludedRecordCount", "sample", "riskSummary", "riskCustomers", "loanTermDistribution", "industryDistribution", "provinceDistribution", "validation"],
  "properties": {
    "dataSourceName": { "type": "string", "minLength": 1 },
    "sourceFields": {
      "type": "object",
      "additionalProperties": { "type": ["string", "null"] },
      "required": ["contractSerial", "customerName", "branch", "beginningRisk", "latestRisk", "riskResult", "guaranteeMethod", "province", "industry", "businessProduct", "loanTerm", "loanBalance", "contractAmount"]
    },
    "countBasis": { "type": "string", "enum": ["contract_serial", "valid_rows"] },
    "countBasisField": { "type": ["string", "null"] },
    "fallbackCode": { "type": ["string", "null"], "enum": ["missing_contract_serial", "blank_contract_serial", "conflicting_contract_records", null] },
    "analyzedRecordCount": { "type": "integer", "minimum": 0 },
    "excludedRecordCount": { "type": "integer", "minimum": 0 },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "loanBalance"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "loanBalance": { "type": "number", "minimum": 0 }
      }
    },
    "riskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nonNormalCount", "nonNormalCountShare", "attentionCount", "nonperformingCount", "nonNormalLoanBalance", "nonNormalLoanBalanceShare", "attentionLoanBalance", "nonperformingLoanBalance", "deteriorationCount"],
      "properties": {
        "nonNormalCount": { "type": "integer", "minimum": 0 },
        "nonNormalCountShare": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "attentionCount": { "type": "integer", "minimum": 0 },
        "nonperformingCount": { "type": "integer", "minimum": 0 },
        "nonNormalLoanBalance": { "type": "number", "minimum": 0 },
        "nonNormalLoanBalanceShare": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "attentionLoanBalance": { "type": "number", "minimum": 0 },
        "nonperformingLoanBalance": { "type": "number", "minimum": 0 },
        "deteriorationCount": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "riskCustomers": { "type": "array", "items": { "$ref": "#/$defs/riskCustomer" } },
    "loanTermDistribution": { "type": "array", "items": { "$ref": "#/$defs/featureItem" } },
    "industryDistribution": { "type": "array", "items": { "$ref": "#/$defs/featureItem" } },
    "provinceDistribution": { "type": "array", "items": { "$ref": "#/$defs/featureItem" } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleReconciled", "riskCustomerCountReconciled", "amountReconciled", "sequenceContinuous"],
      "properties": {
        "sampleReconciled": { "const": true },
        "riskCustomerCountReconciled": { "const": true },
        "amountReconciled": { "const": true },
        "sequenceContinuous": { "const": true }
      }
    }
  },
  "$defs": {
    "riskCustomer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "riskGroup", "contractSerial", "customerName", "branch", "beginningRisk", "latestRisk", "riskResult", "guaranteeMethod", "province", "industry", "businessProduct", "loanTerm", "loanBalance", "contractAmount", "loanBalanceShare"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "riskGroup": { "type": "string", "enum": ["attention", "nonperforming"] },
        "contractSerial": { "type": ["string", "null"] },
        "customerName": { "type": "string", "minLength": 1 },
        "branch": { "type": ["string", "null"] },
        "beginningRisk": { "type": ["string", "null"] },
        "latestRisk": { "type": "string", "minLength": 1 },
        "riskResult": { "type": ["string", "null"] },
        "guaranteeMethod": { "type": ["string", "null"] },
        "province": { "type": ["string", "null"] },
        "industry": { "type": ["string", "null"] },
        "businessProduct": { "type": ["string", "null"] },
        "loanTerm": { "type": ["string", "null"] },
        "loanBalance": { "type": "number", "minimum": 0 },
        "contractAmount": { "type": ["number", "null"], "minimum": 0 },
        "loanBalanceShare": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "featureItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "attentionCount", "nonperformingCount", "totalCount", "loanBalance"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "attentionCount": { "type": "integer", "minimum": 0 },
        "nonperformingCount": { "type": "integer", "minimum": 0 },
        "totalCount": { "type": "integer", "minimum": 0 },
        "loanBalance": { "type": "number", "minimum": 0 }
      }
    }
  }
}
