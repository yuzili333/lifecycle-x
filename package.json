{
  "name": "lifecycle-x",
  "private": true,
  "version": "0.1.0",
  "description": "存续期业务数据探针智能体",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "node scripts/dev-project.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup-project.mjs",
    "submission:package": "node scripts/submission-package.mjs",
    "desktop:build": "pnpm --filter @lifecycle-x/desktop build",
    "desktop:dev": "pnpm --filter @lifecycle-x/desktop dev",
    "desktop:typecheck": "node ./node_modules/typescript/bin/tsc --noEmit -p ./apps/desktop/tsconfig.json",
    "harness:check": "node scripts/verify-harness.mjs",
    "harness:test": "node --test scripts/verify-harness.test.mjs",
    "lint": "eslint apps --max-warnings 0",
    "review-tooling:test": "node --test scripts/review-tooling.test.mjs",
    "submission:test": "node --test scripts/submission-package.test.mjs",
    "server:build": "pnpm --filter @lifecycle-x/server build",
    "server:dev": "pnpm --filter @lifecycle-x/server dev",
    "server:test": "pnpm --filter @lifecycle-x/server test",
    "server:typecheck": "pnpm --filter @lifecycle-x/server typecheck",
    "test": "node scripts/test-project.mjs",
    "typecheck": "pnpm -r typecheck",
    "worktree:check": "node scripts/check-worktree.mjs",
    "verify:fast": "pnpm harness:check && pnpm harness:test && pnpm review-tooling:test && pnpm submission:test && pnpm lint && pnpm typecheck && pnpm worktree:check",
    "verify": "node scripts/verify-project.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "beautiful-mermaid": "^1.1.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.7.0"
}
